# Environment
ENVIRONMENT=DEV

# Lark Bot Configuration
LARK_APP_ID=cli_xxxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Topic Thread IDs
LARK_TOPIC_QUICKGUIDE=omt_xxxxxxxxxxxxxxxx
LARK_TOPIC_COMMANDS=omt_xxxxxxxxxxxxxxxx
LARK_TOPIC_DAILYREPORT=omt_xxxxxxxxxxxxxxxx

# Topic Message IDs (for replies)
LARK_TOPIC_QUICKGUIDE_MSG=om_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_TOPIC_COMMANDS_MSG=om_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_TOPIC_DAILYREPORT_MSG=om_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Authorization (comma-separated user IDs)
LARK_AUTHORIZED_USERS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot Configuration
POLL_INTERVAL=30
COMMAND_PREFIX=/
LOG_LEVEL=INFO

# File Paths
WALLETS_FILE=wallets.json

# API Keys (for crypto balance checking)
TRON_API_KEY=your_tron_api_key_here
ETHEREUM_API_KEY=your_etherscan_api_key_here

# ngrok (for webhook tunneling)
NGROK_KZG_TOKEN=your_ngrok_token_here

# GOOGLE
GOOGLE_CREDENTIALS_FILE=your-serviceaccount-key.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
JSON_FILE_PATH=wallets.json

# LOG
LOG_RETENTION_DAYS=3
